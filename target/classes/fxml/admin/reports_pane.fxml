<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.view.ReportGeneratorView">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="527.0">
                     <children>
                        <Label fx:id="reportsLabel" text="Reports" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="407.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="56.0" prefWidth="215.0">
                           <children>
                              <TextField fx:id="searchReportTextField" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="60.0" text="Search" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="413.0" spacing="3.0">
                     <children>
                        <ComboBox fx:id="sortByComboBox" prefHeight="25.0" prefWidth="108.0" promptText="Sort By" />
                        <Button fx:id="saveReportButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="97.0" text="Save Report" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="521.0" prefWidth="805.0">
         <children>
            <TabPane fx:id="reportsTabPane" prefHeight="800.0" prefWidth="805.0" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab fx:id="logReportTab" text="Log Report">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <TableView fx:id="logReportTableView" focusTraversable="false" layoutY="6.0" minHeight="-Infinity" prefHeight="482.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
                                 <columns>
                                    <TableColumn fx:id="resIDColumn1" editable="false" prefWidth="184.0" resizable="false" text="User ID" />
                                    <TableColumn fx:id="terminalColumn1" editable="false" prefWidth="148.0" resizable="false" text="User Type" />
                                    <TableColumn fx:id="roomNumberColumn1" editable="false" prefWidth="204.0" resizable="false" text="Actions" />
                                    <TableColumn fx:id="statusColumn1" editable="false" prefWidth="123.0" resizable="false" text="Date" />
                                    <TableColumn fx:id="statusColumn12" editable="false" prefWidth="145.0" resizable="false" text="Time" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                  <Tab fx:id="reservationReportTab" text="Reservation Report">
                     <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <TableView fx:id="reservationReportTableView" focusTraversable="false" layoutY="6.0" minHeight="-Infinity" prefHeight="482.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
                                 <columns>
                                    <TableColumn fx:id="resIDColumn11" editable="false" prefWidth="177.0" resizable="false" text="Reservation ID" />
                                    <TableColumn fx:id="terminalColumn11" editable="false" prefWidth="118.0" resizable="false" text="Terminal No." />
                                    <TableColumn fx:id="roomNumberColumn11" editable="false" prefWidth="154.0" resizable="false" text="Room No." />
                                    <TableColumn fx:id="statusColumn11" editable="false" minWidth="0.0" prefWidth="164.0" resizable="false" text="Reservation Status" />
                                    <TableColumn fx:id="statusColumn111" editable="false" minWidth="0.0" prefWidth="191.0" resizable="false" text="Terminal Status" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
              </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</VBox>
