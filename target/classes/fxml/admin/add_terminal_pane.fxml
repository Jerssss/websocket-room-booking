<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.view.AddNewTerminalView">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="402.0">
                     <children>
                        <Label fx:id="studResTitleLabel" text="Add Terminals" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="378.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="256.0">
                           <children>
                              <TextField fx:id="searchTerminalTextField" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="60.0" text="Search" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="229.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="163.0">
                           <children>
                              <Button fx:id="redirectAddTerminalWindowButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="170.0" text="Add a terminal" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="175.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="61.0">
                           <children>
                              <Button fx:id="refreshButton" mnemonicParsing="false" prefWidth="60.0" text="Refresh" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="addTerminalTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="1015.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
         <columns>
            <TableColumn fx:id="terminalColumn" editable="false" prefWidth="104.0" resizable="false" text="Terminal No." />
            <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="105.0" resizable="false" text="Room No." />
            <TableColumn fx:id="terminalOSColumn" editable="false" prefWidth="140.0" resizable="false" text="Terminal OS" />
            <TableColumn fx:id="dayColumn" editable="false" prefWidth="153.0" resizable="false" text="Day" />
            <TableColumn fx:id="timeColumn" editable="false" prefWidth="132.0" resizable="false" text="Time" />
            <TableColumn fx:id="statusColumn" editable="false" prefWidth="170.0" resizable="false" text="Status" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
