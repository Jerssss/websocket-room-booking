<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.student.view.ViewReservationView">
   <children>
      <VBox alignment="CENTER" prefHeight="62.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="513.0">
                     <children>
                        <Label fx:id="viewResLabel" text="View Reservation(s)" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="227.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="56.0" prefWidth="215.0">
                           <children>
                              <TextField fx:id="searchResTextField" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="60.0" text="Search" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="76.0">
                     <children>
                        <Button fx:id="refreshButton" mnemonicParsing="false" text="Refresh" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="484.0" prefWidth="805.0">
         <children>
            <TableView fx:id="viewResTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="472.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
               <columns>
                  <TableColumn fx:id="reservationIDColumn" editable="false" prefWidth="115.0" resizable="false" text="Reservation ID" />
                  <TableColumn fx:id="terminalNumberColumn" editable="false" prefWidth="115.0" resizable="false" text="Terminal No." />
                  <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="115.0" resizable="false" text="Room No." />
                  <TableColumn fx:id="dateColumn" editable="false" prefWidth="115.0" resizable="false" text="Date" />
                  <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="115.0" resizable="false" text="Start Time" />
                  <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="115.0" resizable="false" text="End Time" />
                  <TableColumn fx:id="statusColumn" editable="false" prefWidth="115.0" resizable="false" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
