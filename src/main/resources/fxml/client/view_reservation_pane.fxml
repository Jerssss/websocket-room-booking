<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.student.view.ViewReservationView">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="100.0">
                     <children>
                        <Label fx:id="historyLabel" text="History">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="25.0" />
                           </HBox.margin>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="67.0" prefWidth="284.0" spacing="5.0">
                     <children>
                        <Label fx:id="timePickerLabel" text="Time:" />
                        <TextField fx:id="startTimeTextField" prefHeight="29.0" prefWidth="86.0" promptText="00:00" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                        <Label fx:id="colonLabel" text=":" />
                        <TextField fx:id="endTimeTextField" prefHeight="29.0" prefWidth="86.0" promptText="00:00" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="67.0" prefWidth="336.0" spacing="5.0">
                     <children>
                        <Label fx:id="dateLabel" text="Date:" />
                        <TextField fx:id="monthTextField" prefHeight="29.0" prefWidth="86.0" promptText="MM" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                        <Label text="/" />
                        <TextField fx:id="dayTextField" prefHeight="29.0" prefWidth="86.0" promptText="DD" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                        <Label text="/" />
                        <TextField fx:id="yearTextField" prefHeight="29.0" prefWidth="86.0" promptText="YY" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="99.0">
                     <children>
                        <Button fx:id="refreshButton" mnemonicParsing="false" text="Refresh" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="484.0" prefWidth="805.0">
         <children>
            <TableView fx:id="modResTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="472.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
               <columns>
                  <TableColumn fx:id="reservationIDColumn" editable="false" prefWidth="120.0" resizable="false" text="Reservation ID" />
                  <TableColumn fx:id="userIDColumn" editable="false" prefWidth="120.0" resizable="false" text="User ID" />
                  <TableColumn fx:id="terminalIDColumn" editable="false" prefWidth="120.0" resizable="false" text="Terminal ID" />
                  <TableColumn fx:id="reservationDateColumn" editable="false" prefWidth="120.0" resizable="false" text="Reservation Date" />
                  <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="100.0" resizable="false" text="Start Time" />
                  <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="100.0" resizable="false" text="End Time" />
                  <TableColumn fx:id="statusColumn" editable="false" prefWidth="120.0" resizable="false" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
