<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css"
      fx:controller="client.admin.view.ModifyTerminalStatusView" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="400.0">
                     <children>
                        <Label fx:id="modResLabel" text="Modify Reservations" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="450.0" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="181.0">
                           <children>
                              <ComboBox fx:id="terminalOSComboBox" prefWidth="150.0" promptText="Terminal OS" />
                           </children>
                        </HBox>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="150.0" prefWidth="200.0">
                           <children>
                              <TextField fx:id="searchStudResTextField" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="60.0" text="Search" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="484.0" prefWidth="805.0">
         <children>
            <TableView fx:id="modResTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="1015.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
               <columns>
                  <TableColumn fx:id="resIDColumn" editable="false" prefWidth="177.0" resizable="false" text="Reservation ID" />
                  <TableColumn fx:id="terminalColumn" editable="false" prefWidth="187.0" resizable="false" text="Terminal No." />
                  <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="235.0" resizable="false" text="Room No." />
                  <TableColumn fx:id="statusColumn" editable="false" prefWidth="205.0" resizable="false" text="Edit" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
