<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0"
      styleClass="background-pane"
      stylesheets="@../../css/styles.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.admin.view.ReservationApprovalView"
>
   <children>
      <!-- Header Section -->
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
               <children>
                  <!-- Title Section -->
                  <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="605.0">
                     <children>
                        <Label fx:id="approveResLabel" text="Approve Reservations" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>

                  <!-- Filter Section (Added) -->
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="316.0" spacing="10.0">
                     <children>
                        <!-- Filter by Date ComboBox -->
                        <ComboBox fx:id="filterByComboBox" promptText="Sort by..." prefWidth="150.0">
                           <items>
                              <FXCollections fx:factory="observableArrayList">
                                 <String fx:value="Filter by Date" />
                                 <String fx:value="Filter by User ID" />
                              </FXCollections>
                           </items>
                        </ComboBox>

                        <!-- Date Filter TextField (Initially invisible) -->
                        <TextField fx:id="dateFilterTextField" promptText="Enter Date"
                                   visible="false" prefWidth="150.0" />
                     </children>
                  </HBox>

                  <!-- Search Section -->
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="316.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="150.0" prefWidth="243.0">
                           <children>
                              <TextField fx:id="searchStudResTextField" promptText="Enter keywords..."/>
                              <Button fx:id="searchButton" mnemonicParsing="false" prefWidth="60.0" text="Search" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>

                  <!-- Refresh Section -->
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="175.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="61.0">
                           <children>
                              <Button fx:id="refreshButton" mnemonicParsing="false" prefWidth="60.0" text="Refresh" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Table Section -->
      <VBox alignment="CENTER" prefHeight="484.0" prefWidth="805.0">
         <children>
            <TableView fx:id="approveResTableView" focusTraversable="false"
                       minHeight="-Infinity" prefHeight="477.0" prefWidth="1015.0"
                       style="-fx-font-size: 13;">
               <columns>
                  <TableColumn fx:id="reservationIdColumn" editable="false" prefWidth="177.0" text="Reservation ID" />
                  <TableColumn fx:id="userIdColumn" editable="false" prefWidth="134.0" text="User ID" />
                  <TableColumn fx:id="terminalNoColumn" editable="false" text="Terminal No." />
                  <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="131.0" text="Room No." />
                  <TableColumn fx:id="dateColumn" editable="false" prefWidth="188.0" text="Date" />
                  <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="174.0" text="Start Time" />
                  <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="174.0" text="End Time" />
                  <TableColumn fx:id="statusColumn" editable="false" prefWidth="189.0" text="Status" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>

